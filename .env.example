# Telegram bot (не публикуйте настоящий .env)
BOT_TOKEN=
ADMIN_ID=0

# Данные для входа администратора на сайте
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-this-admin-password
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SECURE=false  # true только после включения HTTPS

# База данных и адрес сайта
DATABASE_URL=sqlite:///library.db
HOST=127.0.0.1
PORT=8000
SITE_URL=https://your-domain.example
